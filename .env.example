# Stripe (required for the consultation booking payment to work)
# Get your secret key from https://dashboard.stripe.com/apikeys
# Use a "sk_test_..." key while testing and a "sk_live_..." key in production.
STRIPE_SECRET_KEY=

# Base URL used to build Stripe's success/cancel redirect links.
# Set this to your deployed domain in production, e.g. https://iraqrenewable.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Consultation booking fee in USD (Stripe does not support IQD).
NEXT_PUBLIC_CONSULTATION_FEE_USD=100

# Optional: a webhook URL (e.g. Slack incoming webhook, Zapier, Make.com)
# that the "Contact us" form will POST new inquiries to.
# If left empty, submissions are only logged on the server.
CONTACT_WEBHOOK_URL=
